         EXTRAS: ""
+        BUILD_ONNX: "true"
     container_name: proctoring-ai-worker
     env_file:
       - .env
@@ -75,6 +73,14 @@ services:
       # El worker le pide a la API que analizar y le devuelve lo medido. Por
       # nombre de servicio: dentro de la red de compose, `api` resuelve solo.
       PROCTORING_API_URL: http://api:8000
+      SIMILARITY_BACKEND: onnx-int8
+      ASR_PROVIDER: deepgram
+      ASR_FALLBACK_PROVIDER: none
+    deploy:
+      resources:
+        limits:
+          cpus: "1.0"
+          memory: 512M
     depends_on:
       redis:
         condition: service_healthy
