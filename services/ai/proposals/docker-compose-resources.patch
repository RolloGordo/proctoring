diff --git a/docker-compose.yml b/docker-compose.yml
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -61,12 +61,10 @@ services:
       context: ./services/ai
       dockerfile: Dockerfile
       args:
-        # En local no se instala `similarity`: el worker de compose es el
-        # esqueleto y nadie tiene los pesos del modelo montados. Asi la imagen
-        # se queda en 471 MB en disco (113 MB al descargar) y no arrastra torch.
-        # La de produccion se construye con el valor por defecto del Dockerfile,
