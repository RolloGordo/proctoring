diff --git a/services/ai/Dockerfile b/services/ai/Dockerfile
index edc8f31..0206a99 100644
--- a/services/ai/Dockerfile
+++ b/services/ai/Dockerfile
@@ -48,6 +48,17 @@ COPY pyproject.toml uv.lock ./
 RUN --mount=type=cache,target=/root/.cache/uv \
     uv sync --locked --no-dev ${EXTRAS}
 
+# Generacion reproducible del modelo ONNX (revision fijada, Apache-2.0)
+# dentro del builder, sin copiar desde carpetas ignoradas por git.
+ARG BUILD_ONNX="false"
+COPY spikes/__init__.py spikes/network.py spikes/export_onnx.py ./spikes/
+RUN if [ "$BUILD_ONNX" = "true" ]; then \
+        uv pip install onnx && \
+        python spikes/export_onnx.py --source hf --out-dir /app/models/onnx_minilm_experiment --int8-only; \
+    else \
+        mkdir -p /app/models/onnx_minilm_experiment; \
+    fi
+
 # ---------------------------------------------------------------------------
 # Etapa 2 — runtime
 # ---------------------------------------------------------------------------
@@ -82,6 +93,7 @@ COPY --chown=proctoring:proctoring \
     tasks.py worker_stub.py salud.py audio_runtime.py deepgram_transcriber.py face_pipeline.py ./
 COPY --chown=proctoring:proctoring spikes/__init__.py spikes/metrics.py spikes/network.py \
     spikes/similarity.py spikes/synthetic_voice.py spikes/transcribe.py ./spikes/
+COPY --from=builder --chown=proctoring:proctoring /app/models/onnx_minilm_experiment /app/models/onnx_minilm_experiment
 
 # Donde insightface descarga su modelo, con dueno.
