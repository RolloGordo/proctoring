# Copia este archivo como .env y rellena los valores. NUNCA subas .env al repositorio.

# ---------- General ----------
# local | test | staging | production
ENV=local
API_PORT=8000

# ---------- Seguridad ----------
# Exige "Authorization: Bearer <token de Supabase Auth>" en los endpoints de la API,
# y comprueba que un estudiante solo registre y lea eventos SOBRE SI MISMO.
#
# Esta en false para que la app de escritorio y el spike de vision puedan mandar
# eventos antes de tener su pantalla de login. En cuanto exista el login, ponlo en true.
#
# La API SOLO arranca con AUTH_ENABLED=false si ENV es local o test. Si falta esta
# variable, la autenticacion queda ACTIVADA: en un despliegue, olvidarla protege
# en vez de abrir.
AUTH_ENABLED=false

# Secreto compartido entre la API y services/ai para los endpoints internos
# (cabecera X-Internal-Token). La API se niega a arrancar con AUTH_ENABLED=true y
# sin este valor: dejaria abiertos los endpoints que escriben evidencia de IA.
# Genera uno largo:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# Docente al que se atribuyen las sesiones cuando AUTH_ENABLED=false.
#
# Con EVENT_REPOSITORY=memory vale cualquier UUID y no hay que tocar nada.
#
# Con supabase NO: exam_sessions.teacher_id tiene clave foranea a profiles, asi
# que un id inventado hace fallar la creacion de la sesion, y el error aparece
# lejos de aqui. Pon el id de un docente real de tu proyecto:
#
#   select id, email, role from public.profiles where role = 'teacher';
DEV_TEACHER_ID=

# ---------- Seleccion de adaptadores (hexagonal) ----------
# memory  -> todo en memoria, no necesita Supabase ni Redis (modo por defecto para desarrollo)
# supabase -> persiste en la tabla public.events
EVENT_REPOSITORY=memory
# memory | redis
JOB_QUEUE=memory
# memory | supabase
EVIDENCE_STORAGE=memory

# ---------- Supabase ----------
# Proyecto proctoring, ref uzuysjmymvtpoxfrdxnm. Ver supabase/README.md.
SUPABASE_URL=https://uzuysjmymvtpoxfrdxnm.supabase.co
# Clave publicable (sb_publishable_...): la usan la web y la app, es segura en el cliente.
SUPABASE_PUBLISHABLE_KEY=
# SECRETA. Copiala del dashboard (Project Settings > API). Omite RLS: solo en el servidor.
# Nunca la subas al repositorio; en CI va en GitHub Secrets.
SUPABASE_SERVICE_ROLE_KEY=
# Buckets privados ya creados por la migracion 20261003120200.
SUPABASE_EVIDENCE_BUCKET=evidences
SUPABASE_AUDIO_BUCKET=audio-segments
SUPABASE_REFERENCE_FACES_BUCKET=reference-faces

# ---------- Cola de trabajos ----------
REDIS_URL=redis://redis:6379/0

# ---------- CORS (separar varios origenes con coma) ----------
CORS_ORIGINS=http://localhost:5173

# Con AUTH_ENABLED=false, quien pide el examen se hace pasar por este estudiante.
# Lo mismo que DEV_TEACHER_ID: con memory vale cualquiera, con supabase tiene
# que existir de verdad en `profiles` o lo que se guarde falla por clave ajena.
DEV_STUDENT_ID=

# Desactivalo solo para pruebas de carga locales.
RATE_LIMIT_ENABLED=true

# ---------- Servicio de IA ----------
# Direccion del worker de IA. En local no hace falta: esta siempre despierto.
# En produccion SI, y no es opcional: los planes gratuitos apagan un servicio
# sin peticiones, y un worker que solo consume de una cola no recibe ninguna.
# Con esto puesto, la API lo despierta cada vez que encola un trabajo.
AI_SERVICE_URL=http://localhost:8001

# ---------- Transcripcion de audio (services/ai) ----------
# Motor principal: faster-whisper (por defecto) | deepgram
ASR_PROVIDER=faster-whisper
# Modelo local: tiny | base | small (por defecto small, int8, CPU)
ASR_LOCAL_MODEL=small
# Respaldo cuando faster-whisper falla o no pasa la puerta de calidad: none (por defecto) | deepgram
# Con ASR_FALLBACK_PROVIDER=none el sistema funciona 100 % local sin conexion externa ni DEEPGRAM_API_KEY.
# Nota de privacidad: con ASR_FALLBACK_PROVIDER=deepgram, los fragmentos que no pasen
# la puerta de calidad se envian a la API externa de Deepgram (sin incluir el enunciado).
ASR_FALLBACK_PROVIDER=none
# Disparar respaldo si faster-whisper devuelve transcripcion vacia (true | false)
ASR_FALLBACK_ON_EMPTY=true
# VAD local de faster-whisper (Silero VAD)
ASR_LOCAL_VAD_FILTER=true
ASR_LOCAL_VAD_THRESHOLD=0.3
# Umbrales de la puerta de calidad (calibrados en muestra sobre 28 audios, sin validacion independiente)
ASR_MIN_WORDS_PER_SECOND=0.50
ASR_MAX_NO_SPEECH_PROB=0.60
ASR_MIN_AVG_LOGPROB=-0.60
ASR_MAX_COMPRESSION_RATIO=1.85
ASR_HALLUCINATION_PHRASES=suscríbete,suscribete,más información en www,mas informacion en www,subtítulos realizados por,subtitulos realizados por,amara.org,gracias por ver
# Presupuesto de latencia para el respaldo: min(4.5s, 10s - elapsed - 1.5s)
ASR_LATENCY_BUDGET_SECONDS=10.0
ASR_FALLBACK_MAX_TIMEOUT_SECONDS=4.5
ASR_POST_ASR_RESERVE_SECONDS=1.5
# Backend de similitud semantica: torch (por defecto) | onnx-int8 | onnx-fp32
SIMILARITY_BACKEND=torch
# Vocabulario del modelo ONNX de similitud: es_en (recortado ES/EN, ~221 MiB RSS) | full (250k tokens)
SIMILARITY_ONNX_VOCAB=es_en
# Comprobacion de memoria en cgroup al arrancar: false (solo aviso en log y /health) | true (fallo fatal)
ASR_ENFORCE_MEMORY_BUDGET=false
# Clave de Deepgram Nova-3 (requerida si ASR_PROVIDER=deepgram o ASR_FALLBACK_PROVIDER=deepgram)
DEEPGRAM_API_KEY=
DEEPGRAM_TIMEOUT_SECONDS=8.0
