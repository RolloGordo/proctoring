# Copia este archivo como .env y rellena los valores. NUNCA subas .env al repositorio.

# ---------- General ----------
# local | test | staging | production
ENV=local
API_PORT=8000

# ---------- Seguridad ----------
# Exige "Authorization: Bearer <token de Supabase Auth>" en los endpoints de la API,
# y comprueba que un estudiante solo registre y lea eventos SOBRE SI MISMO.
#
# Esta en false para que la app de escritorio y el spike de vision puedan mandar
# eventos antes de tener su pantalla de login. En cuanto exista el login, ponlo en true.
#
# La API SOLO arranca con AUTH_ENABLED=false si ENV es local o test. Si falta esta
# variable, la autenticacion queda ACTIVADA: en un despliegue, olvidarla protege
# en vez de abrir.
AUTH_ENABLED=false

# Secreto compartido entre la API y services/ai para los endpoints internos
# (cabecera X-Internal-Token). La API se niega a arrancar con AUTH_ENABLED=true y
# sin este valor: dejaria abiertos los endpoints que escriben evidencia de IA.
# Genera uno largo:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# Docente al que se atribuyen las sesiones cuando AUTH_ENABLED=false.
#
# exam_sessions.teacher_id tiene clave foranea a profiles, asi que el valor por
# defecto (00000000-0000-4000-8000-000000000001) NO existe en Supabase y crear
# una sesion con EVENT_REPOSITORY=supabase fallaria. Pon aqui el id de un docente
# real de tu proyecto para probar el camino completo antes de que exista el login:
#
#   select id, email, role from public.profiles where role = 'teacher';
DEV_TEACHER_ID=

# ---------- Seleccion de adaptadores (hexagonal) ----------
# memory  -> todo en memoria, no necesita Supabase ni Redis (modo por defecto para desarrollo)
# supabase -> persiste en la tabla public.events
EVENT_REPOSITORY=memory
# memory | redis
JOB_QUEUE=memory
# memory | supabase
EVIDENCE_STORAGE=memory

# ---------- Supabase ----------
# Proyecto proctoring, ref uzuysjmymvtpoxfrdxnm. Ver supabase/README.md.
SUPABASE_URL=https://uzuysjmymvtpoxfrdxnm.supabase.co
# Clave publicable (sb_publishable_...): la usan la web y la app, es segura en el cliente.
SUPABASE_PUBLISHABLE_KEY=
# SECRETA. Copiala del dashboard (Project Settings > API). Omite RLS: solo en el servidor.
# Nunca la subas al repositorio; en CI va en GitHub Secrets.
SUPABASE_SERVICE_ROLE_KEY=
# Buckets privados ya creados por la migracion 20261003120200.
SUPABASE_EVIDENCE_BUCKET=evidences
SUPABASE_AUDIO_BUCKET=audio-segments
SUPABASE_REFERENCE_FACES_BUCKET=reference-faces

# ---------- Cola de trabajos ----------
REDIS_URL=redis://redis:6379/0

# ---------- CORS (separar varios origenes con coma) ----------
CORS_ORIGINS=http://localhost:5173

# ---------- Servicio de IA ----------
AI_SERVICE_URL=http://localhost:8001
